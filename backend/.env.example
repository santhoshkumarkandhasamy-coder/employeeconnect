# Backend env vars needed by plans 00/01. devops: merge into deploy/.env.example.
APP_ENV=dev                          # dev | test | prod (REQUIRED to be explicit; unset = prod: no /docs, no CORS)
LOG_LEVEL=INFO
CORS_ORIGINS=
# Reverse-proxy CIDRs whose X-Real-IP / X-Forwarded-For are trusted (audit + IP rate limits). Empty = trust nothing,
# every request is attributed to the direct peer. Behind nginx in docker set the compose network, e.g. 172.18.0.0/16.
# nginx MUST overwrite the header (proxy_set_header X-Real-IP $remote_addr;) and port 8000 must not be published.
TRUSTED_PROXIES=

# Connect as the NON-OWNER role app_user (migrations/seed run as app_owner).
DATABASE_URL=postgresql+asyncpg://app_user:CHANGE_ME@postgres:5432/employeeconnect
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# >= 32 random bytes:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SESSION_MAX_DAYS=90                  # absolute session lifetime; rotation never extends past it
REFRESH_GRACE_SECONDS=15             # lost-response tolerance for the immediately previous refresh token
JWT_LEEWAY_SECONDS=10                # clock-skew tolerance when validating access tokens

# Comma separated Fernet keys, newest first:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEYS=

# Argon2id (tune to ~100-250 ms on the server)
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=2

# Auth tuning
LOGIN_RATE_IP=20
LOGIN_RATE_EID=10
LOGIN_RATE_WINDOW_SECONDS=600
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
FORGOT_MIN_LATENCY_MS=300            # forgot-password response time floor (timing equalisation)
TEMP_PASSWORD_HOURS=72               # admin-issued temporary passwords stop working after this (1-720); login -> 403 TEMP_PASSWORD_EXPIRED
SENSITIVE_VIEW_ALERT_PER_HOUR=100    # personal-data employee detail views per admin per hour before the admins are alerted
ARGON2_MAX_THREADS=4                 # concurrent password hash/verify threads

# Optional integrations (empty = disabled)
AUDIT_HMAC_KEY=                      # >= 32 chars: openssl rand -hex 32
FCM_CREDENTIALS_FILE=                # e.g. /run/app-secrets/fcm.json (file must exist when set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                           # required when SMTP_HOST is set

# Files / uploads (module files)
FILE_STORAGE_DIR=/data/files         # docker volume, outside any web root
MAX_UPLOAD_MB=10
UPLOAD_RATE_PER_MIN=20
MAX_IMAGE_PIXELS=16000000
IMAGE_CONCURRENCY=2
PUNCH_FAIL_LIMIT=5                   # rejected punches (geofence/accuracy/stale/mock) per window before a cool-down
PUNCH_FAIL_WINDOW_SECONDS=600
FORGOT_RATE_EID=3                    # forgot-password requests per hour per employee id
FORGOT_RATE_IP=10                    # ... per IP

# Leave / permission write limits (per user; Redis down = refuse)
LEAVE_WRITE_RATE_PER_MIN=10          # apply + cancel (both kinds together)
LEAVE_WRITE_RATE_PER_DAY=50
LEAVE_DECIDE_RATE_PER_MIN=60         # approve + reject per approver

# Excel export (reviews 04 / 08): workbooks are built in a worker thread; temp files go to a private dir under EXPORT_TEMP_DIR.
# EXPORT_TEMP_DIR is REQUIRED when APP_ENV=prod (absolute path of a dedicated, size-limited tmpfs/volume used by nothing else;
# the app creates it with mode 0700). Empty is allowed in dev/test only (system temp dir).
EXPORT_TEMP_DIR=
EXPORT_MAX_CONCURRENCY=2             # simultaneous builds per process (1-8); others wait 5 s, then 503
EXPORT_TIMEOUT_S=60                  # whole-build budget incl. the row counts (5-600); exceeded -> 422 RANGE_TOO_LARGE
EXPORT_MAX_ROWS=200000               # per sheet, counted before writing (1000-1000000)
EXPORT_MAX_PENDING_DOWNLOADS=8       # built-but-not-yet-downloaded workbooks per process (1-100); more -> 503
EXPORT_DAILY_MAX_EXPORTS=30          # per user and UTC day; more -> 429 EXPORT_QUOTA_EXCEEDED
EXPORT_DAILY_MAX_ROWS=2000000        # delivered rows per user and UTC day (>= 1000)
EXPORT_WARN_ROWS=50000               # one export with at least this many rows (all sheets) logs a WARNING (logger app.export)
EXPORT_DAILY_WARN_EXPORTS=10         # exports per user and day that start logging a WARNING
EXPORT_DAILY_WARN_ROWS=500000        # rows per user and day that start logging a WARNING
EXPORT_TEAM_WINDOW_MONTHS=12         # team-scope (export.team) callers may not export further back than this; 0 = off

# Announcements (module 06)
ANNOUNCE_WRITE_RATE_PER_MIN=10       # admin create/update/delete per user
ANNOUNCE_READ_RATE_PER_MIN=120       # mark-read per user
ANNOUNCE_PUSH_BATCH=500              # device tokens per FCM call
ANNOUNCE_PUSH_MAX_USERS=5000         # fan-out ceiling per announcement
ANNOUNCEMENT_DELETED_RETENTION_DAYS=30   # soft-deleted announcements lose their image/PDF links after N days
ANNOUNCEMENT_RENOTIFY_COOLDOWN_MIN=60    # min minutes between re-sent pushes of one announcement
ANNOUNCEMENT_PUSH_BUDGET_PER_DAY=20      # push-generating announcement writes (create + renotify) per admin per 24 h

# Profile / home (module 07)
PROFILE_WRITE_RATE_PER_MIN=10
CELEBRATIONS_WINDOW_DAYS=7

