<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext, and no user-installed CAs. Certificate pinning itself is done
     in Dart (CERT_PINS), this is the OS level backstop. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
