# Employee Connect deployment settings. Copy to deploy/.env (chmod 600) and fill in. NEVER commit .env.
# Print fresh secrets with:  ./scripts/gen-secrets.sh
# Passwords/keys must be URL-safe (hex / token_urlsafe) because they are embedded in DATABASE_URL / REDIS_URL.
# Do not put quotes or inline comments on a value line you fill in.

# ---- general -----------------------------------------------------------------------------------------------
# APP_VERSION: image tag AND the version the api reports in its health endpoint; set to a release (e.g. 1.0.0) to pin
APP_VERSION=latest
# APP_ENV: prod | dev | test. prod = no /docs, empty CORS enforced, placeholder JWT secrets rejected
APP_ENV=prod
LOG_LEVEL=INFO
# CORS_ORIGINS must stay empty in prod (mobile app only)
CORS_ORIGINS=

# ---- network -----------------------------------------------------------------------------------------------
# Internal compose network and the fixed address of the nginx container on it. The api trusts X-Real-IP /
# X-Forwarded-For ONLY from NGINX_IP (compose sets TRUSTED_PROXIES=$NGINX_IP/32). Wrong => every client looks
# like nginx and the whole company shares one login rate-limit bucket; too wide => clients could spoof their IP.
# Change NET_SUBNET only if it collides with your LAN/VPN ranges. NGINX_IP must be inside it and not the .1 gateway.
NET_SUBNET=172.31.250.0/24
NGINX_IP=172.31.250.10
# If a load balancer sits IN FRONT of nginx, see docs/DEPLOY.md (real_ip); never add it to TRUSTED_PROXIES.

# ---- host ports ---------------------------------------------------------------------------------------------------
# Ports this server publishes for Employee Connect. Change them only if another program already uses 80 / 443 here
# (the RFS Generator uses 8501, which does not clash). With a non-standard HTTPS port, add it to PUBLIC_ORIGIN, the
# router port-forward and the app's server address (e.g. https://hr.company.example:8443).
HTTP_PORT=80
HTTPS_PORT=443

# ---- public access / admin console (docs/DEPLOY.md section 6 "Internet exposure") ---------------------------
# The ONE host name the app, the phones and the console use (public DNS record, split-horizon DNS inside the office).
# nginx serves only this Host/SNI; every other name or a bare IP address is refused. Letters, digits, dots, hyphens only.
PUBLIC_HOSTNAME=hr.company.example
# https://<PUBLIC_HOSTNAME> (add :port only if not 443). Browser Origin accepted by /api/auth/web/* (console login CSRF guard).
PUBLIC_ORIGIN=https://hr.company.example
# Comma separated IPs/CIDRs allowed to open /console/ and /api/auth/web/*, e.g. 192.168.1.0/24,10.8.0.0/24 (office LAN + admin VPN).
# Empty (default) = allow-list OFF: the console is reachable from the internet (Admin role only, strict login rate limit, per-employee lockout).
# Set it to restrict the console to the office/VPN later; the mobile API is unaffected.
CONSOLE_ALLOW_CIDRS=
# Option D only (VPS relay, docker-compose.relay.yml): WireGuard address of THIS server and of the VPS. Leave empty for option A.
WG_BIND_IP=
RELAY_PEER_IP=

# ---- PostgreSQL --------------------------------------------------------------------------------------------
# POSTGRES_USER is the owner role: runs migrations, seed, backups.
POSTGRES_USER=app_owner
POSTGRES_DB=employeeconnect
# openssl rand -hex 24
POSTGRES_PASSWORD=
# Password of the runtime role app_user (DML only; cannot change/delete audit rows). The `dbrole` service runs
# ALTER ROLE app_user LOGIN PASSWORD '<this>' on every `up`.   openssl rand -hex 24
APP_DB_PASSWORD=
# Compose expands ${...} from this file. Leave as is unless you change host/db names.
DATABASE_URL=postgresql+asyncpg://app_user:${APP_DB_PASSWORD}@postgres:5432/${POSTGRES_DB}
OWNER_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ---- Redis -------------------------------------------------------------------------------------------------
# openssl rand -hex 24
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ---- tokens & encryption -----------------------------------------------------------------------------------
# JWT_SECRET >= 32 bytes:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SESSION_MAX_DAYS=90
REFRESH_GRACE_SECONDS=15
JWT_LEEWAY_SECONDS=10
# Comma separated Fernet keys, NEWEST FIRST (rotation: prepend a new key, keep old ones until data is re-encrypted).
# LOSING THESE KEYS = LOSING ALL ENCRYPTED PERSONAL/LOCATION DATA. Store a copy apart from the DB backups.
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEYS=
# Optional audit chain HMAC:  openssl rand -hex 32
AUDIT_HMAC_KEY=

# ---- Argon2id / auth tuning --------------------------------------------------------------------------------
# api memory limit in compose is 1g: keep ARGON2_MEMORY_KIB x ARGON2_MAX_THREADS well below it.
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=2
ARGON2_MAX_THREADS=4
# Login limits. PRIMARY = per employee (LOGIN_RATE_EID + lockout): keep it tight. LOGIN_RATE_IP is a per-IP backstop only
# and must be HIGH because staff behind ONE office NAT share an IP (~ head-count x 1.5 per window; 300 suits ~200 staff).
# nginx.conf zones `login`/`authapi` (300/600 r/min per IP) are the matching edge backstop: raise both together.
LOGIN_RATE_IP=300
LOGIN_RATE_EID=10
LOGIN_RATE_WINDOW_SECONDS=600
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
FORGOT_MIN_LATENCY_MS=300
FORGOT_RATE_EID=3
FORGOT_RATE_IP=10
# Admin-issued temporary passwords expire after this many hours (1-720); login then answers TEMP_PASSWORD_EXPIRED.
TEMP_PASSWORD_HOURS=72
# Personal-data employee views per admin and hour before the other admins are alerted.
SENSITIVE_VIEW_ALERT_PER_HOUR=100

# ---- files / notifications / mail --------------------------------------------------------------------------
# App upload limit. Files live on the `uploads` volume at /data/files (fixed in compose). nginx allows 12m bodies ONLY on
# `location = /api/files` (nginx.conf; all other routes 256k). KEEP IN SYNC: nginx limit = MAX_UPLOAD_MB + ~2 MB multipart overhead.
MAX_UPLOAD_MB=10
UPLOAD_RATE_PER_MIN=20
MAX_IMAGE_PIXELS=16000000
IMAGE_CONCURRENCY=2
# Rejected punches (geofence / accuracy / stale fix / mock) per window before a cool-down.
PUNCH_FAIL_LIMIT=5
PUNCH_FAIL_WINDOW_SECONDS=600
# FCM service-account JSON: put it in deploy/secrets/api/ (mounted read-only at /run/app-secrets), chown 10001, chmod 400,
# then e.g. /run/app-secrets/fcm.json. Real push also needs firebase-admin in the image: set FIREBASE_ADMIN_VERSION
# (build arg of deploy/api.Dockerfile, e.g. 6.9.0 - pin one you tested) and rebuild. Empty = not installed, push skipped.
FCM_CREDENTIALS_FILE=
FIREBASE_ADMIN_VERSION=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- leave / permission write limits (per user; Redis down = refuse) ---------------------------------------
LEAVE_WRITE_RATE_PER_MIN=10
LEAVE_WRITE_RATE_PER_DAY=50
LEAVE_DECIDE_RATE_PER_MIN=60

# ---- Excel export (docs/reviews/08-export-security.md) ----------------------------------------------------
# EXPORT_TEMP_DIR is REQUIRED in prod: the api refuses to start without it. Compose mounts a private tmpfs (mode 0700, owned by the
# api user, size EXPORT_TMPFS_SIZE) at this path in the api container; keep the path absolute and used by nothing else.
# The tmpfs counts against the api memory limit (1g): 256m is fine for the default EXPORT_MAX_ROWS and concurrency 2.
EXPORT_TEMP_DIR=/exports
EXPORT_TMPFS_SIZE=256m
EXPORT_MAX_CONCURRENCY=2
EXPORT_TIMEOUT_S=60
EXPORT_MAX_ROWS=200000
EXPORT_MAX_PENDING_DOWNLOADS=8
# Per-user daily ceilings (UTC day); past them the export answers 429 EXPORT_QUOTA_EXCEEDED. The WARN values only log.
EXPORT_DAILY_MAX_EXPORTS=30
EXPORT_DAILY_MAX_ROWS=2000000
EXPORT_WARN_ROWS=50000
EXPORT_DAILY_WARN_EXPORTS=10
EXPORT_DAILY_WARN_ROWS=500000
# Team-scope (export.team) callers cannot export further back than this many months; 0 = off.
EXPORT_TEAM_WINDOW_MONTHS=12

# ---- announcements / profile --------------------------------------------------------------------------
ANNOUNCE_WRITE_RATE_PER_MIN=10
ANNOUNCE_READ_RATE_PER_MIN=120
ANNOUNCE_PUSH_BATCH=500
ANNOUNCE_PUSH_MAX_USERS=5000
ANNOUNCEMENT_DELETED_RETENTION_DAYS=30
ANNOUNCEMENT_RENOTIFY_COOLDOWN_MIN=60
ANNOUNCEMENT_PUSH_BUDGET_PER_DAY=20
PROFILE_WRITE_RATE_PER_MIN=10
CELEBRATIONS_WINDOW_DAYS=7

# ---- seed (first deploy only; prefer `-e` on the command line, see docs/DEPLOY.md) ----------------------------
# Preferred first-admin path: SEED_SKIP_ADMIN=1 (or `seed --no-admin`) + `python -m scripts.create_admin create`.
SEED_SKIP_ADMIN=
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_M=
# e.g. Asia/Kolkata
OFFICE_TIMEZONE=

# ---- backups (database/scripts/backup.sh, daily, in the `backup` container) --------------------------------
BACKUP_TIME_UTC=02:00
# uploads volume archive (backup-uploads.sh), nightly; stored in the same volume, same encryption and retention
BACKUP_UPLOADS_TIME_UTC=02:30
BACKUP_RETENTION_DAYS=14
# Choose ONE mode. Public-key (A) is recommended: the private key never lives on this server.
#  A) put the armored PUBLIC key in deploy/secrets/backup/backup_public.asc (chown 999, chmod 400), then set:
#     BACKUP_GPG_RECIPIENT=backup@company.example
#     BACKUP_GPG_PUBLIC_KEY_FILE=/run/backup-secrets/backup_public.asc
#  B) symmetric: put a long random passphrase in deploy/secrets/backup/backup_passphrase (chown 999, chmod 400), then set:
#     BACKUP_PASSPHRASE_FILE=/run/backup-secrets/backup_passphrase
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_PUBLIC_KEY_FILE=
BACKUP_PASSPHRASE_FILE=

# ---- local development only (docker-compose.dev.yml; see docs/SETUP.md "Local development") ----------------------
# DEV_BIND=127.0.0.1 keeps the API on this PC; 0.0.0.0 opens it to the LAN (phone testing, dev secrets only).
# DEV_API_PORT=8000

# ---- health endpoint inputs (leave at defaults unless you changed the mounts in docker-compose.yml) -------------
# STATUS_DIR: volume `status` (backup service writes backup.json: db_last_success_at / uploads_last_success_at; api mounts it read-only).
STATUS_DIR=/status
# TLS_CERT_FILE: ./certs/fullchain.pem mounted read-only into the api; its expiry is reported (degraded < 14 days). Empty = no TLS check.
TLS_CERT_FILE=/certs/fullchain.pem
